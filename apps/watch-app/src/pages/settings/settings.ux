}

.danger-btn {
  width: 396px;
  height: 60px;
  border-radius: 30px;
  background-color: #e11d48;
  color: #ffffff;
  font-size: 22px;
  font-weight: bold;
}

.btn-disabled {
  opacity: 0.6;
}

/* 关于区 */
.about-box {
  flex-direction: column;
  align-items: center;
  margin-top: 10px;
  margin-bottom: 24px;
}

