<template>
  <div class="page">
    <scroll class="scroll-container" scroll-y="true">
      <!-- 顶部导航 -->
      <div class="nav-bar">
        <input class="back-btn" type="button" value="返回" onclick="goBack" />
        <text class="page-title">手表设置</text>
        <div class="nav-placeholder"></div>
      </div>

      <!-- 当前后端地址卡片 -->
      <div class="card">
        <text class="card-label">当前 API 同步地址</text>
        <text class="card-url">{{currentUrl}}</text>

        <!-- 连通性测试结果提示 -->
        <div class="test-result-box" if="{{hasTested}}">
          <text class="test-result-text {{testSuccess ? 'text-emerald' : 'text-rose'}}">
            {{testMessage}}
          </text>
        </div>

        <input
          class="test-btn {{isTesting ? 'btn-disabled' : ''}}"
          type="button"
          value="{{isTesting ? '正在测试...' : '测试网络连通性'}}"
          onclick="testConnection"
        />
      </div>

      <!-- 快捷预设地址卡片 -->
      <div class="card">
        <text class="card-label">快捷预设切换</text>

        <div class="preset-btn-list">
          <input
            class="preset-item {{currentUrl === 'https://om.nle.lol/api' ? 'preset-active' : ''}}"
            type="button"
            value="默认主站 (om.nle.lol)"
            onclick="selectPreset('https://om.nle.lol/api')"
          />
        </div>
      </div>

      <!-- 缓存与操作 -->
      <div class="card">
        <text class="card-label">本地数据管理</text>
        <input
          class="danger-btn"
          type="button"
          value="清除本地额度缓存"
          onclick="handleClearCache"
        />
      </div>

      <!-- 底部关于信息 -->
      <div class="about-box">
        <text class="about-text">星环流动 OmniFlow Watch v1.0</text>
        <text class="about-sub">Xiaomi Vela OS 穿戴专属算力聚合引擎</text>
      </div>

      <div class="bottom-spacer"></div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import vibrator from '@system.vibrator'
import fetch from '@system.fetch'
import {
  getApiBaseUrl,
  setApiBaseUrl,
  getFullEndpoint,
  DEFAULT_API_BASE_URL
} from '../../common/api.js'
import { clearStorage } from '../../common/storage.js'

export default {
  private: {
    currentUrl: DEFAULT_API_BASE_URL,
    isTesting: false,
    hasTested: false,
    testSuccess: false,
    testMessage: ''
  },

  onInit() {
    this.loadCurrentConfig()
  },

  async loadCurrentConfig() {
    const url = await getApiBaseUrl()
    this.currentUrl = url
  },

  async selectPreset(url) {
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}

    this.currentUrl = url
    await setApiBaseUrl(url)
    this.hasTested = false

    try {
      prompt.showToast({ message: '已切换' })
    } catch (e) {}
  },

  async testConnection() {
    if (this.isTesting) return
    this.isTesting = true
    this.hasTested = false

    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}

    const startTime = Date.now()
    const targetUrl = getFullEndpoint(this.currentUrl, '/watch/sync')

    fetch.fetch({
      url: targetUrl,
      method: 'GET',
      responseType: 'json',
      timeout: 10000,
      success: () => {
        const latency = Date.now() - startTime
        this.isTesting = false
        this.hasTested = true
        this.testSuccess = true
        this.testMessage = `连接成功 (${latency}ms)`
        try {
          prompt.showToast({ message: '连接畅通' })
        } catch (e) {}
      },
      fail: (data, code) => {
        this.isTesting = false
        this.hasTested = true
        this.testSuccess = false
        this.testMessage = `无法连接服务器 (${code || 'fail'})`
        try {
          prompt.showToast({ message: '连接失败' })
        } catch (e) {}
      }
    })
  },

  async handleClearCache() {
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}

    await clearStorage()
    await setApiBaseUrl(this.currentUrl)

    try {
      prompt.showToast({ message: '缓存已清空' })
    } catch (e) {}
  },

  goBack() {
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}
    router.back()
  }
}
</script>

