  color: #a1a1aa;
  font-size: 19px;
  font-weight: bold;
  margin-bottom: 10px;
}

.card-url {
  color: #ffffff;
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 14px;
}

.test-result-box {
  margin-bottom: 12px;
}

.test-result-text {
  font-size: 18px;
  font-weight: bold;
}

.test-btn {
  width: 396px;
  height: 60px;
  border-radius: 30px;
  background-color: #6366f1;
  color: #ffffff;
  font-size: 22px;
  font-weight: bold;
}

.preset-btn-list {
  flex-direction: column;
}

.preset-item {
  width: 396px;
  height: 58px;
  border-radius: 29px;
  background-color: #3f3f46;
  color: #ffffff;
  font-size: 20px;
  margin-bottom: 12px;
}

.preset-active {
  background-color: #6366f1;
  color: #ffffff;
