.card {
  flex-direction: column;
  background-color: #141416;
  border-radius: 20px;
  border-width: 2px;
  border-color: #27272a;
  padding: 16px 18px;
  margin-bottom: 14px;
}

.card-label {
  color: #a1a1aa;
  font-size: 15px;
  margin-bottom: 8px;
}

.card-url {
  color: #ffffff;
  font-size: 17px;
  font-weight: bold;
  margin-bottom: 12px;
}

.test-result-box {
  margin-bottom: 10px;
}

.test-result-text {
  font-size: 15px;
  font-weight: bold;
}

.test-btn {
  width: 400px;
  height: 48px;
  border-radius: 24px;
  background-color: #312e81;
  color: #c7d2fe;
  font-size: 16px;
  font-weight: bold;
}

.preset-btn-list {
  flex-direction: column;
}

.preset-item {
  width: 400px;
  height: 46px;
  border-radius: 23px;
  background-color: #27272a;
  color: #e4e4e7;
  font-size: 14px;
  margin-bottom: 8px;
}

.preset-active {
  background-color: #4f46e5;
  color: #ffffff;
  font-weight: bold;
}

.danger-btn {
  width: 400px;
  height: 48px;
  border-radius: 24px;
  background-color: #881337;
  color: #fecdd3;
  font-size: 16px;
}

.btn-disabled {
  opacity: 0.6;
}

/* 关于区 */
.about-box {
  flex-direction: column;
  align-items: center;
  margin-top: 10px;
  margin-bottom: 20px;
}

.about-text {
  color: #71717a;
  font-size: 14px;
}

.about-sub {
  color: #52525b;
  font-size: 12px;
  margin-top: 4px;
}

