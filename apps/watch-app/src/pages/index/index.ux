<template>
  <div class="page">
    <scroll class="scroll-container" scroll-y="true">
      <!-- 顶部状态栏 (自适应椭圆边角，左右元素缩进 20px) -->
      <div class="header-bar">
        <div class="brand-box">
          <image class="brand-logo-img" src="/common/logo.png"></image>
          <text class="brand-title">星环流动</text>
        </div>
        <div class="status-badge">
          <text class="count-text" if="{{keys.length > 0}}">{{keys.length}} 节点</text>
          <text class="status-text {{isOffline ? 'text-zinc' : 'text-emerald'}}">
            {{isOffline ? '离线' : '在线'}}
          </text>
        </div>
      </div>

      <!-- 空状态提示 -->
      <div class="empty-card" if="{{!isLoading && keys.length === 0}}">
        <text class="empty-title">暂无算力配置</text>
        <text class="empty-desc">请在 Web 控制台添加 API 资源或托管账号</text>
        <input
          class="empty-btn"
          type="button"
          value="刷新同步"
          onclick="handleSync"
        />
      </div>

      <!-- 动态额度卡片列表 -->
      <div class="card-list" if="{{keys.length > 0}}">
        <div
          class="quota-card"
          for="{{(idx, item) in keys}}"
          onclick="goDetail(item.id)"
        >
          <!-- A. Token Plane 类型卡片 -->
          <div class="card-content" if="{{item.isTokenPlane}}">
            <div class="card-top">
              <div class="provider-badge {{item.avatarBgClass}}">
                <text class="avatar-text">{{item.avatarText}}</text>
              </div>
              <div class="info-col">
                <div class="title-row">
                  <text class="item-name">{{item.name}}</text>
                  <text class="plan-badge {{item.planBadgeClass}}" if="{{item.planType}}">{{item.planType}}</text>
                </div>
                <text class="item-sub" if="{{item.email}}">{{item.email}}</text>
              </div>
            </div>

            <!-- 主额度区 -->
            <div class="quota-main-row">
              <div class="percent-box">
                <text class="percent-val {{item.percentColorClass}}">{{item.remainingPercent}}%</text>
                <text class="percent-desc">剩余可用额度</text>
              </div>
              <div class="countdown-box" if="{{item.countdownText}}">
                <text class="countdown-val">{{item.countdownText}}</text>
                <text class="countdown-desc">后自动重置</text>
              </div>
            </div>

            <!-- 加粗主进度条 -->
            <div class="progress-track">
              <div class="progress-fill {{item.progressBgClass}}" style="width: {{item.progressWidth}}px;"></div>
            </div>
          </div>

          <!-- B. API Key 类型卡片 -->
          <div class="card-content" if="{{!item.isTokenPlane}}">
            <div class="card-top">
              <div class="provider-badge bg-emerald-box">
                <text class="avatar-text">KEY</text>
              </div>
              <div class="info-col">
                <div class="title-row">
                  <text class="item-name">{{item.name}}</text>
                  <text class="status-pill-text {{item.statusClass}}">{{item.statusLabel}}</text>
                </div>
                <text class="item-sub" if="{{item.maskedKey}}">{{item.maskedKey}}</text>
              </div>
            </div>

            <!-- Endpoint 显示 -->
            <div class="endpoint-box" if="{{item.baseUrl}}">
              <text class="endpoint-label">接入点:</text>
              <text class="endpoint-url">{{item.baseUrl}}</text>
            </div>

            <!-- 三格探针指标: RPM, TPM, 延迟 -->
            <div class="probe-grid" if="{{item.quotaInfo}}">
              <div class="probe-cell">
                <text class="probe-label">剩余 RPM</text>
                <text class="probe-val text-indigo">{{item.quotaInfo.remainingRequests !== undefined ? item.quotaInfo.remainingRequests : '---'}}</text>
              </div>
              <div class="probe-cell">
                <text class="probe-label">剩余 TPM</text>
                <text class="probe-val text-emerald">{{item.tpmText}}</text>
              </div>
              <div class="probe-cell">
                <text class="probe-label">探针延迟</text>
                <text class="probe-val text-sky">{{item.quotaInfo.latencyMs !== undefined ? item.quotaInfo.latencyMs + 'ms' : '---'}}</text>
              </div>
            </div>
          </div>

          <!-- 卡片底栏 -->
          <div class="card-bottom">
            <text class="card-time" if="{{item.lastTestedAt}}">更新于 {{item.lastTestedTime}}</text>
            <text class="card-time" if="{{!item.lastTestedAt}}">未测算</text>
            <text class="card-action">查看详情 &gt;</text>
          </div>
        </div>
      </div>

      <!-- 操作功能区 (左右双按钮: 刷新数据 + 同步配额) -->
      <div class="action-section">
        <div class="action-row">
          <input
            class="action-btn-half sync-btn {{isLoading ? 'btn-disabled' : ''}}"
            type="button"
            value="{{isLoading ? '刷新中...' : '刷新数据'}}"
            onclick="handleSync"
          />
          <input
            class="action-btn-half check-btn {{isCheckingAll ? 'btn-disabled' : ''}}"
            type="button"
            value="{{isCheckingAll ? '同步中...' : '同步配额'}}"
            onclick="handleCheckAll"
          />
        </div>

        <input
          class="settings-btn"
          type="button"
          value="服务器配置"
          onclick="goSettings"
        />
      </div>

      <!-- 底部同步信息 -->
      <div class="footer-meta">
        <text class="meta-time">上次同步: {{lastSyncTime}}</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import vibrator from '@system.vibrator'
import {
  queryWatchQuota,
  probeAllWatchQuota,
  STORAGE_KEY_LAST_SYNC_TIME
} from '../../common/api.js'
import { getStorage } from '../../common/storage.js'
import {
  formatCountdown,
  getPercentTheme,
  getProviderAvatar,
  maskApiKey,
  formatTestedTime
} from '../../common/formatter.js'

export default {
  private: {
    isLoading: false,
    isCheckingAll: false,
    isOffline: false,
    lastSyncTime: '--:--',
    keys: [],
    timerId: null
  },

  onInit() {
    this.loadLastSyncTime()
    this.fetchData(false)
    this.startCountdownTimer()
  },

  onShow() {
    this.fetchData(false)
  },

  onDestroy() {
    if (this.timerId) {
      clearInterval(this.timerId)
      this.timerId = null
    }
  },

  async loadLastSyncTime() {
    const time = await getStorage(STORAGE_KEY_LAST_SYNC_TIME, '')
    if (time) {
      this.lastSyncTime = time
    }
  },

  startCountdownTimer() {
    if (this.timerId) return
    this.timerId = setInterval(() => {
      if (!this.keys || this.keys.length === 0) return
      this.keys.forEach((k) => {
        if (k.isTokenPlane && k.rawSecondsRemaining > 0) {
          k.rawSecondsRemaining = Math.max(0, k.rawSecondsRemaining - 5)
          k.countdownText = formatCountdown(k.rawSecondsRemaining)
        }
      })
    }, 5000)
  },

  async handleSync() {
    if (this.isLoading || this.isCheckingAll) return

    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}

    await this.fetchData(true)
  },

  async handleCheckAll() {
    if (this.isLoading || this.isCheckingAll) return
    this.isCheckingAll = true

    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}

    try {
      const res = await probeAllWatchQuota()
      this.isOffline = res.isFromCache

      if (res.keys) {
        this.processKeys(res.keys)

        const now = new Date()
        this.lastSyncTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`

        try {
          prompt.showToast({
            message: res.isFromCache ? '已展示本地缓存' : '配额同步完成'
          })
        } catch (e) {}
      }
    } catch (err) {
      try {
        prompt.showToast({ message: '同步异常' })
      } catch (e) {}
    } finally {
      this.isCheckingAll = false
    }
  },

  async fetchData(isManual = false) {
    this.isLoading = true

    try {
      const res = await queryWatchQuota()
      this.isOffline = res.isFromCache

      if (res.keys) {
        this.processKeys(res.keys)

        const now = new Date()
        this.lastSyncTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`

        if (isManual) {
          try {
            prompt.showToast({
              message: res.isFromCache ? '已展示本地缓存' : '数据已刷新'
            })
          } catch (e) {}
        }
      }
    } catch (err) {
      if (isManual) {
        try {
          prompt.showToast({ message: '刷新异常' })
        } catch (e) {}
      }
    } finally {
      this.isLoading = false
    }
  },

  processKeys(rawKeys) {
    if (!rawKeys || !Array.isArray(rawKeys)) {
      this.keys = []
      return
    }

    const processed = rawKeys.map((item) => {
      const isTp = item.type === 'token-plane' || item.provider === 'google-antigravity' || item.provider === 'openai-codex'

      // Token Plane 字段计算
      const remainingPercent = item.tokenQuota?.remainingPercentage ?? 100
      const progressWidth = Math.max(12, Math.min(404, Math.floor((remainingPercent / 100) * 404)))
      const theme = getPercentTheme(remainingPercent, item.provider)
      const rawSecs = item.tokenQuota?.secondsRemaining || 0
      const planType = item.tokenQuota?.planType || ''

      let planBadgeClass = 'badge-slate'
      if (planType.toLowerCase().includes('ultra')) {
        planBadgeClass = 'badge-amber'
      } else if (planType.toLowerCase().includes('pro')) {
        planBadgeClass = 'badge-indigo'
      }

      // API Key 探针字段
      let statusLabel = '未检测'
      let statusClass = 'pill-zinc'
      if (item.status === 'active') {
        statusLabel = '正常'
        statusClass = 'pill-emerald'
      } else if (item.status === 'error') {
        statusLabel = '异常'
        statusClass = 'pill-rose'
      }

      let tpmText = '---'
      if (item.quotaInfo?.remainingTokens !== undefined) {
        tpmText = `${(item.quotaInfo.remainingTokens / 1000).toFixed(0)}K`
      }

      const avatar = getProviderAvatar(item.provider)

      return {
        id: item.id,
        name: item.name,
        type: item.type,
        provider: item.provider,
        baseUrl: item.baseUrl,
        email: item.email,
        isTokenPlane: isTp,
        avatarText: avatar.text,
        avatarBgClass: avatar.bgClass,
        remainingPercent,
        progressWidth,
        percentColorClass: theme.colorClass,
        progressBgClass: theme.bgClass,
        rawSecondsRemaining: rawSecs,
        countdownText: formatCountdown(rawSecs),
        planType,
        planBadgeClass,
        maskedKey: maskApiKey(item.apiKey),
        statusLabel,
        statusClass,
        quotaInfo: item.quotaInfo,
        tpmText,
        lastTestedAt: item.lastTestedAt,
        lastTestedTime: formatTestedTime(item.lastTestedAt)
      }
    })

    this.keys = processed
  },

  goDetail(id) {
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}

    router.push({
      uri: '/pages/detail',
      params: { id }
    })
  },

  goSettings() {
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}

    router.push({
      uri: '/pages/settings'
    })
  }
}
</script>

