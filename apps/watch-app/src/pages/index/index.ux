<template>
  <div class="page">
    <scroll class="scroll-container" scroll-y="true">
      <!-- 顶部状态栏 (Brand + Network Status) -->
      <div class="header-bar">
        <div class="brand-box">
          <image class="brand-logo-img" src="/common/logo.png"></image>
          <text class="brand-title">星环流动</text>
        </div>
        <div class="status-badge">
          <text class="status-text {{isOffline ? 'text-zinc' : 'text-emerald'}}">
            {{isOffline ? '● 离线' : '● 在线'}}
          </text>
        </div>
      </div>

      <!-- 概览统计条 (真实数据统计) -->
      <div class="stats-row" if="{{keys.length > 0}}">
        <text class="stats-item">共 {{keys.length}} 节点</text>
        <text class="stats-item">托管: {{tokenPlaneCount}}</text>
        <text class="stats-item">API: {{apiKeyCount}}</text>
      </div>

      <!-- 空状态提示 (当尚未在 Web 控制台添加任何 Key 时) -->
      <div class="empty-card" if="{{!isLoading && keys.length === 0}}">
        <div class="empty-icon-box">
          <text class="empty-icon">📂</text>
        </div>
        <text class="empty-title">暂无算力配置</text>
        <text class="empty-desc">请在 Web 端【AI 算力控制中心】添加 API 资源或托管账号</text>
        <input
          class="empty-btn"
          type="button"
          value="⚡ 刷新尝试同步"
          onclick="handleSync"
        />
      </div>

      <!-- 动态额度卡片列表 (与 QuotaConsole.vue 严格对齐) -->
      <div class="card-list" if="{{keys.length > 0}}">
        <div
          class="quota-card"
          for="{{(idx, item) in keys}}"
          onclick="goDetail(item.id)"
        >
          <!-- ========== A. Token Plane 类型卡片 (Antigravity & Codex) ========== -->
          <div class="card-content" if="{{item.isTokenPlane}}">
            <!-- 头部：图标 + 标题 + 邮箱 + PlanType -->
            <div class="card-top">
              <div class="provider-badge {{item.avatarBgClass}}">
                <text class="avatar-text">{{item.avatarText}}</text>
              </div>
              <div class="info-col">
                <text class="item-name">{{item.name}}</text>
                <text class="item-sub" if="{{item.email}}">{{item.email}}</text>
              </div>
              <div class="badge-col" if="{{item.planType}}">
                <text class="plan-badge {{item.planBadgeClass}}">{{item.planType}}</text>
              </div>
            </div>

            <!-- 主额度区 (圆形/大字百分比 + 倒计时) -->
            <div class="quota-main-row">
              <div class="percent-box">
                <text class="percent-val {{item.percentColorClass}}">{{item.remainingPercent}}%</text>
                <text class="percent-desc">剩余可用额度</text>
              </div>
              <div class="countdown-box" if="{{item.countdownText}}">
                <text class="countdown-val">{{item.countdownText}}</text>
                <text class="countdown-desc">后额度自动重置</text>
              </div>
            </div>

            <!-- 细条主进度条 -->
            <div class="progress-track">
              <div class="progress-fill {{item.progressBgClass}}" style="width: {{item.progressWidth}}px;"></div>
            </div>

            <!-- 子模型细项列表 (如 Gemini 2.5 Flash / Pro, Claude 3.7 Sonnet) -->
            <div class="sub-details-box" if="{{item.details && item.details.length > 0}}">
              <div class="sub-item" for="{{(dIdx, d) in item.details}}">
                <div class="sub-row">
                  <text class="sub-name">{{d.name}}</text>
                  <text class="sub-percent {{d.colorClass}}">{{d.remainingPercentage}}%</text>
                </div>
                <div class="progress-track-sm">
                  <div class="progress-fill {{d.bgClass}}" style="width: {{d.calcWidth}}px;"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- ========== B. API Key 类型卡片 (通用密钥 & 探针指标) ========== -->
          <div class="card-content" if="{{!item.isTokenPlane}}">
            <div class="card-top">
              <div class="provider-badge bg-emerald-box">
                <text class="avatar-text">KEY</text>
              </div>
              <div class="info-col">
                <text class="item-name">{{item.name}}</text>
                <text class="item-sub" if="{{item.maskedKey}}">{{item.maskedKey}}</text>
              </div>
              <div class="badge-col">
                <text class="status-pill-text {{item.statusClass}}">{{item.statusLabel}}</text>
              </div>
            </div>

            <!-- Endpoint 显示 -->
            <div class="endpoint-box" if="{{item.baseUrl}}">
              <text class="endpoint-label">Endpoint:</text>
              <text class="endpoint-url">{{item.baseUrl}}</text>
            </div>

            <!-- 三格探针指标: RPM, TPM, 延迟 -->
            <div class="probe-grid" if="{{item.quotaInfo}}">
              <div class="probe-cell">
                <text class="probe-label">剩余 RPM</text>
                <text class="probe-val text-indigo">{{item.quotaInfo.remainingRequests !== undefined ? item.quotaInfo.remainingRequests : '---'}}</text>
              </div>
              <div class="probe-cell">
                <text class="probe-label">剩余 TPM</text>
                <text class="probe-val text-emerald">{{item.tpmText}}</text>
              </div>
              <div class="probe-cell">
                <text class="probe-label">探针延迟</text>
                <text class="probe-val text-sky">{{item.quotaInfo.latencyMs !== undefined ? item.quotaInfo.latencyMs + 'ms' : '---'}}</text>
              </div>
            </div>
          </div>

          <!-- 卡片底栏 (更新时间 + 状态) -->
          <div class="card-bottom">
            <text class="card-time" if="{{item.lastTestedAt}}">更新于 {{item.lastTestedTime}}</text>
            <text class="card-time" if="{{!item.lastTestedAt}}">未测算</text>
            <text class="card-action">查看详情 ❯</text>
          </div>
        </div>
      </div>

      <!-- 操作功能区 -->
      <div class="action-section">
        <input
          class="sync-btn {{isLoading ? 'btn-disabled' : ''}}"
          type="button"
          value="{{isLoading ? '正在同步云端...' : '⚡ 同步全盘算力'}}"
          onclick="handleSync"
        />

        <input
          class="settings-btn"
          type="button"
          value="⚙️ 服务器配置"
          onclick="goSettings"
        />
      </div>

      <!-- 底部同步信息 -->
      <div class="footer-meta">
        <text class="meta-time">上次同步: {{lastSyncTime}}</text>
        <text class="meta-tip">数据源与 Web 控制台 100% 实时同步</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import vibrator from '@system.vibrator'
import {
  queryWatchQuota,
  STORAGE_KEY_LAST_SYNC_TIME
} from '../../common/api.js'
import { getStorage } from '../../common/storage.js'

export default {
  private: {
    isLoading: false,
    isOffline: false,
    lastSyncTime: '--:--',
    keys: [],
    tokenPlaneCount: 0,
    apiKeyCount: 0,
    timerId: null
  },

  onInit() {
    this.loadLastSyncTime()
    this.fetchData(false)
    this.startCountdownTimer()
  },

  onShow() {
    // 抬腕亮屏时自动静默刷新
    this.fetchData(false)
  },

  onDestroy() {
    if (this.timerId) {
      clearInterval(this.timerId)
      this.timerId = null
    }
  },

  async loadLastSyncTime() {
    const time = await getStorage(STORAGE_KEY_LAST_SYNC_TIME, '')
    if (time) {
      this.lastSyncTime = time
    }
  },

  startCountdownTimer() {
    if (this.timerId) return
    this.timerId = setInterval(() => {
      if (!this.keys || this.keys.length === 0) return
      let hasUpdate = false
      const updated = this.keys.map((k) => {
        if (k.isTokenPlane && k.rawSecondsRemaining > 0) {
          k.rawSecondsRemaining -= 1
          k.countdownText = this.formatCountdown(k.rawSecondsRemaining)
          hasUpdate = true
        }
        if (k.details && k.details.length > 0) {
          k.details.forEach((d) => {
            if (d.rawSecondsRemaining > 0) {
              d.rawSecondsRemaining -= 1
              hasUpdate = true
            }
          })
        }
        return k
      })
      if (hasUpdate) {
        this.keys = updated
      }
    }, 1000)
  },

  async handleSync() {
    if (this.isLoading) return

    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}

    await this.fetchData(true)
  },

  async fetchData(isManual = false) {
    this.isLoading = true

    try {
      const res = await queryWatchQuota()
      this.isOffline = res.isFromCache

      if (res.keys) {
        this.processKeys(res.keys)

        const now = new Date()
        const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`
        this.lastSyncTime = timeStr

        if (isManual) {
          try {
            prompt.showToast({
              message: res.isFromCache ? '已展示本地缓存配额' : '✨ 算力配额已同步'
            })
          } catch (e) {}
        }
      }
    } catch (err) {
      if (isManual) {
        try {
          prompt.showToast({ message: '同步异常' })
        } catch (e) {}
      }
    } finally {
      this.isLoading = false
    }
  },

  processKeys(rawKeys) {
    if (!rawKeys || !Array.isArray(rawKeys)) {
      this.keys = []
      this.tokenPlaneCount = 0
      this.apiKeyCount = 0
      return
    }

    let tpCount = 0
    let akCount = 0

    const processed = rawKeys.map((item) => {
      const isTp = item.type === 'token-plane' || item.provider === 'google-antigravity' || item.provider === 'openai-codex'
      if (isTp) {
        tpCount++
      } else {
        akCount++
      }

      // 处理 Token Plane 字段
      let remainingPercent = 100
      let progressWidth = 420
      let percentColorClass = 'text-emerald'
      let progressBgClass = 'bg-emerald'
      let rawSecs = 0
      let countdownText = ''
      let planType = ''
      let planBadgeClass = 'badge-slate'
      let detailsList = []

      if (item.tokenQuota) {
        remainingPercent = item.tokenQuota.remainingPercentage !== undefined ? item.tokenQuota.remainingPercentage : 100
        progressWidth = Math.max(10, Math.min(420, Math.floor((remainingPercent / 100) * 420)))

        if (remainingPercent <= 15) {
          percentColorClass = 'text-rose'
          progressBgClass = 'bg-rose'
        } else if (remainingPercent <= 50) {
          percentColorClass = 'text-amber'
          progressBgClass = 'bg-amber'
        } else {
          percentColorClass = item.provider === 'google-antigravity' ? 'text-indigo' : 'text-emerald'
          progressBgClass = item.provider === 'google-antigravity' ? 'bg-indigo' : 'bg-emerald'
        }

        rawSecs = item.tokenQuota.secondsRemaining || 0
        countdownText = this.formatCountdown(rawSecs)
        planType = item.tokenQuota.planType || ''

        if (planType.toLowerCase().includes('ultra')) {
          planBadgeClass = 'badge-amber'
        } else if (planType.toLowerCase().includes('pro')) {
          planBadgeClass = 'badge-indigo'
        }

        if (item.tokenQuota.details && Array.isArray(item.tokenQuota.details)) {
          detailsList = item.tokenQuota.details.map((d) => {
            const dRem = d.remainingPercentage !== undefined ? d.remainingPercentage : 100
            let dColor = 'text-emerald'
            let dBg = 'bg-emerald'
            if (dRem <= 15) {
              dColor = 'text-rose'
              dBg = 'bg-rose'
            } else if (dRem <= 50) {
              dColor = 'text-amber'
              dBg = 'bg-amber'
            } else {
              dColor = 'text-indigo'
              dBg = 'bg-indigo'
            }
            return {
              name: d.name,
              providerGroup: d.providerGroup,
              remainingPercentage: dRem,
              rawSecondsRemaining: d.secondsRemaining || 0,
              calcWidth: Math.max(8, Math.min(400, Math.floor((dRem / 100) * 400))),
              colorClass: dColor,
              bgClass: dBg
            }
          })
        }
      }

      // 处理 API Key 字段
      let maskedKey = ''
      if (item.apiKey) {
        maskedKey = item.apiKey.length > 10
          ? `${item.apiKey.slice(0, 4)}••••${item.apiKey.slice(-4)}`
          : '••••••••'
      }

      let statusLabel = '未检测'
      let statusClass = 'pill-zinc'
      if (item.status === 'active') {
        statusLabel = '正常'
        statusClass = 'pill-emerald'
      } else if (item.status === 'error') {
        statusLabel = '异常'
        statusClass = 'pill-rose'
      }

      let tpmText = '---'
      if (item.quotaInfo?.remainingTokens !== undefined) {
        tpmText = `${(item.quotaInfo.remainingTokens / 1000).toFixed(0)}K`
      }

      // 图标与背景
      let avatarText = 'TP'
      let avatarBgClass = 'bg-indigo-box'
      if (item.provider === 'google-antigravity') {
        avatarText = 'AG'
        avatarBgClass = 'bg-indigo-box'
      } else if (item.provider === 'openai-codex') {
        avatarText = 'CX'
        avatarBgClass = 'bg-emerald-box'
      } else if (item.provider === 'google-aistudio') {
        avatarText = 'GS'
        avatarBgClass = 'bg-indigo-box'
      } else if (item.provider === 'openai-compatible') {
        avatarText = 'OA'
        avatarBgClass = 'bg-emerald-box'
      }

      let lastTestedTime = ''
      if (item.lastTestedAt) {
        try {
          const d = new Date(item.lastTestedAt)
          lastTestedTime = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`
        } catch (e) {
          lastTestedTime = item.lastTestedAt
        }
      }

      return {
        id: item.id,
        name: item.name,
        type: item.type,
        provider: item.provider,
        baseUrl: item.baseUrl,
        email: item.email,
        isTokenPlane: isTp,
        avatarText,
        avatarBgClass,
        remainingPercent,
        progressWidth,
        percentColorClass,
        progressBgClass,
        rawSecondsRemaining: rawSecs,
        countdownText,
        planType,
        planBadgeClass,
        details: detailsList,
        maskedKey,
        statusLabel,
        statusClass,
        quotaInfo: item.quotaInfo,
        tpmText,
        lastTestedAt: item.lastTestedAt,
        lastTestedTime
      }
    })

    this.keys = processed
    this.tokenPlaneCount = tpCount
    this.apiKeyCount = akCount
  },

  formatCountdown(totalSeconds) {
    if (!totalSeconds || totalSeconds <= 0) return ''
    const hrs = Math.floor(totalSeconds / 3600)
    const mins = Math.floor((totalSeconds % 3600) / 60)
    const secs = totalSeconds % 60

    if (hrs > 0) {
      return `${hrs}h ${mins}m`
    }
    return `${mins}m ${secs}s`
  },

  goDetail(id) {
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}

    router.push({
      uri: '/pages/detail',
      params: {
        id
      }
    })
  },

  goSettings() {
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}

    router.push({
      uri: '/pages/settings'
    })
  }
}
</script>

<style>
