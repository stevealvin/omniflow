  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding-top: 8px;
  border-top-width: 1px;
  border-color: #27272a;
}

.card-time {
  color: #71717a;
  font-size: 13px;
}

.card-action {
  color: #818cf8;
  font-size: 14px;
