<template>
  <div class="page">
    <scroll class="scroll-container" scroll-y="true">
      <!-- 顶部导航栏 (自适应椭圆边角，左右元素缩进 16px) -->
      <div class="nav-bar">
        <input class="back-btn" type="button" value="返回" onclick="goBack" />
        <text class="page-title">{{item ? item.name : '配额详情'}}</text>
        <div class="nav-placeholder"></div>
      </div>

      <!-- 未找到配置提示 -->
      <div class="not-found-card" if="{{!item && !isLoading}}">
        <text class="not-found-title">未找到指定算力配置</text>
        <input class="return-btn" type="button" value="返回列表" onclick="goBack" />
      </div>

      <!-- A. Token Plane 详情大卡片 -->
      <div class="main-card" if="{{item && item.isTokenPlane}}">
        <div class="main-header">
          <div class="icon-box {{item.avatarBgClass}}">
            <text class="icon-text">{{item.avatarText}}</text>
          </div>
          <div class="main-title-col">
            <div class="title-row">
              <text class="main-name">{{item.name}}</text>
              <text class="plan-badge badge-indigo" if="{{item.planType}}">{{item.planType}}</text>
            </div>
            <text class="main-email" if="{{item.email}}">{{item.email}}</text>
          </div>
        </div>

        <div class="main-stat-row">
          <div class="stat-col">
            <text class="stat-num {{item.percentColorClass}}">{{item.remainingPercent}}%</text>
            <text class="stat-label">总剩余配额</text>
          </div>
          <div class="stat-col align-right" if="{{item.countdownText}}">
            <text class="stat-reset-num text-indigo">{{item.countdownText}}</text>
            <text class="stat-label">后额度重置</text>
          </div>
        </div>

        <!-- 主细条进度条 -->
        <div class="progress-track">
          <div class="progress-fill {{item.progressBgClass}}" style="width: {{item.progressWidth}}px;"></div>
        </div>

        <div class="main-meta-row">
          <text class="meta-item" if="{{item.nextResetTime}}">重置时刻: {{item.nextResetTime}}</text>
          <text class="meta-item" if="{{!item.nextResetTime}}">重置周期: 5小时</text>
          <div class="status-pill {{item.pillClass}}">
            <text class="pill-text {{item.percentColorClass}}">{{item.statusLabel}}</text>
          </div>
        </div>
      </div>

      <!-- 子模型细项列表 -->
      <div class="section-box" if="{{item && item.details && item.details.length > 0}}">
        <text class="section-title">子模型配额分配</text>

        <div class="detail-item-card" for="{{(index, d) in item.details}}">
          <div class="detail-top-row">
            <text class="model-name">{{d.name}}</text>
            <text class="model-percent {{d.colorClass}}">{{d.remainingPercentage}}%</text>
          </div>

          <!-- 子模型进度条 -->
          <div class="progress-track-sub">
            <div class="progress-fill {{d.bgClass}}" style="width: {{d.calcWidth}}px;"></div>
          </div>

          <div class="detail-bottom-row">
            <text class="model-group" if="{{d.providerGroup}}">{{d.providerGroup}}</text>
            <text class="model-reset" if="{{d.nextResetTime}}">重置: {{d.nextResetTime}}</text>
          </div>
        </div>
      </div>

      <!-- B. API Key 详情卡片 -->
      <div class="main-card" if="{{item && !item.isTokenPlane}}">
        <div class="main-header">
          <div class="icon-box bg-emerald-box">
            <text class="icon-text">KEY</text>
          </div>
          <div class="main-title-col">
            <div class="title-row">
              <text class="main-name">{{item.name}}</text>
              <text class="status-pill-text {{item.statusClass}}">{{item.statusLabel}}</text>
            </div>
            <text class="main-email" if="{{item.maskedKey}}">{{item.maskedKey}}</text>
          </div>
        </div>

        <div class="meta-field-box" if="{{item.baseUrl}}">
          <text class="meta-field-label">API 接入点 (Endpoint):</text>
          <text class="meta-field-val">{{item.baseUrl}}</text>
        </div>

        <div class="probe-detail-grid" if="{{item.quotaInfo}}">
          <div class="probe-detail-cell">
            <text class="probe-detail-label">剩余 RPM (请求数)</text>
            <text class="probe-detail-val text-indigo">{{item.quotaInfo.remainingRequests !== undefined ? item.quotaInfo.remainingRequests : '---'}}</text>
          </div>
          <div class="probe-detail-cell">
            <text class="probe-detail-label">剩余 TPM (Token)</text>
            <text class="probe-detail-val text-emerald">{{item.tpmText}}</text>
          </div>
          <div class="probe-detail-cell">
            <text class="probe-detail-label">探针往返延迟</text>
            <text class="probe-detail-val text-sky">{{item.quotaInfo.latencyMs !== undefined ? item.quotaInfo.latencyMs + 'ms' : '---'}}</text>
          </div>
        </div>

        <div class="main-meta-row">
          <text class="meta-item">探针状态</text>
          <div class="status-pill {{item.statusClass}}">
            <text class="pill-text">{{item.statusLabel}}</text>
          </div>
        </div>
      </div>

      <!-- 操作按钮 -->
      <div class="action-box" if="{{item}}">
        <input
          class="refresh-btn {{isRefreshing ? 'btn-disabled' : ''}}"
          type="button"
          value="{{isRefreshing ? '正在刷新...' : (item.isTokenPlane ? '刷新此配额' : '触发探针检测')}}"
          onclick="handleSingleCheck"
        />

        <input
          class="return-btn"
          type="button"
          value="返回主表盘"
          onclick="goBack"
        />
      </div>

      <div class="bottom-spacer"></div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import vibrator from '@system.vibrator'
import {
  queryWatchQuota,
  checkSingleKey,
  STORAGE_KEY_QUOTA_CACHE
} from '../../common/api.js'
import { getStorage } from '../../common/storage.js'
import {
  formatCountdown,
  getPercentTheme,
  getProviderAvatar,
  maskApiKey
} from '../../common/formatter.js'

export default {
  protected: {
    id: '',
    provider: ''
  },

  private: {
    isLoading: true,
    isRefreshing: false,
    item: null,
    timerId: null
  },

  onInit() {
    this.loadDetail()
    this.startCountdownTimer()
  },

  onDestroy() {
    if (this.timerId) {
      clearInterval(this.timerId)
      this.timerId = null
    }
  },

  startCountdownTimer() {
    if (this.timerId) return
    this.timerId = setInterval(() => {
      if (!this.item) return
      if (this.item.isTokenPlane && this.item.rawSecondsRemaining > 0) {
        this.item.rawSecondsRemaining -= 1
        this.item.countdownText = formatCountdown(this.item.rawSecondsRemaining)
      }
    }, 1000)
  },

  async loadDetail() {
    this.isLoading = true
    try {
      const cached = await getStorage(STORAGE_KEY_QUOTA_CACHE, null)
      let list = cached?.keys || []

      if (!list || list.length === 0) {
        const res = await queryWatchQuota()
        list = res.keys || []
      }

      const targetId = this.id || ''
      const targetProvider = this.provider || ''

      let found = null
      if (targetId) {
        found = list.find((k) => k.id === targetId)
      }
      if (!found && targetProvider) {
        found = list.find((k) => k.provider === targetProvider)
      }
      if (!found && list.length > 0) {
        found = list[0]
      }

      if (found) {
        this.item = this.formatItem(found)
      }
    } finally {
      this.isLoading = false
    }
  },

  formatItem(raw) {
    const isTp = raw.type === 'token-plane' || raw.provider === 'google-antigravity' || raw.provider === 'openai-codex'

    const remainingPercent = raw.tokenQuota?.remainingPercentage ?? 100
    const progressWidth = Math.max(12, Math.min(410, Math.floor((remainingPercent / 100) * 410)))
    const theme = getPercentTheme(remainingPercent, raw.provider)
    const rawSecs = raw.tokenQuota?.secondsRemaining || 0

    let detailsList = []
    if (raw.tokenQuota?.details && Array.isArray(raw.tokenQuota.details)) {
      detailsList = raw.tokenQuota.details.map((d) => {
        const dRem = d.remainingPercentage !== undefined ? d.remainingPercentage : 100
        const dTheme = getPercentTheme(dRem, d.providerGroup)
        return {
          name: d.name,
          providerGroup: d.providerGroup,
          remainingPercentage: dRem,
          nextResetTime: d.nextResetTime,
          calcWidth: Math.max(10, Math.min(380, Math.floor((dRem / 100) * 380))),
          colorClass: dTheme.colorClass,
          bgClass: dTheme.bgClass
        }
      })
    }

    let statusLabel = '未检测'
    let statusClass = 'pill-zinc'
    if (raw.status === 'active') {
      statusLabel = '探针正常'
      statusClass = 'pill-emerald'
    } else if (raw.status === 'error') {
      statusLabel = '探针异常'
      statusClass = 'pill-rose'
    }

    let tpmText = '---'
    if (raw.quotaInfo?.remainingTokens !== undefined) {
      tpmText = `${(raw.quotaInfo.remainingTokens / 1000).toFixed(0)}K`
    }

    const avatar = getProviderAvatar(raw.provider)

    return {
      id: raw.id,
      name: raw.name,
      type: raw.type,
      provider: raw.provider,
      baseUrl: raw.baseUrl,
      email: raw.email,
      isTokenPlane: isTp,
      avatarText: avatar.text,
      avatarBgClass: avatar.bgClass,
      remainingPercent,
      progressWidth,
      percentColorClass: theme.colorClass,
      progressBgClass: theme.bgClass,
      pillClass: theme.pillClass,
      statusLabel: isTp ? theme.statusLabel : statusLabel,
      statusClass,
      rawSecondsRemaining: rawSecs,
      countdownText: formatCountdown(rawSecs),
      planType: raw.tokenQuota?.planType || '',
      nextResetTime: raw.tokenQuota?.nextResetTime || '',
      details: detailsList,
      maskedKey: maskApiKey(raw.apiKey),
      quotaInfo: raw.quotaInfo,
      tpmText
    }
  },

  async handleSingleCheck() {
    if (this.isRefreshing || !this.item) return
    this.isRefreshing = true

    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}

    try {
      const res = await checkSingleKey(this.item.id)
      if (res.success && res.data) {
        this.item = this.formatItem(res.data)
        try {
          prompt.showToast({ message: '检测完成' })
        } catch (e) {}
      } else {
        const fullRes = await queryWatchQuota()
        if (fullRes.keys) {
          const updated = fullRes.keys.find((k) => k.id === this.item.id)
          if (updated) {
            this.item = this.formatItem(updated)
          }
        }
        try {
          prompt.showToast({ message: '已同步最新配额' })
        } catch (e) {}
      }
    } catch (err) {
      try {
        prompt.showToast({ message: '检测异常' })
      } catch (e) {}
    } finally {
      this.isRefreshing = false
    }
  },

  goBack() {
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}
    router.back()
  }
}
</script>

